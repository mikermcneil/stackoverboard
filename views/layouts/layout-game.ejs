    <meta name="description" content="Stack Overboard: a squid falls out of the sky. Brought to you by Sails.js.">
    <meta name="theme-color" content="#192147">
    <% if (sails.config.environment !== 'production') { %><meta name="robots" content="noindex"><% } %>
