<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Stack Overboard</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
    <meta name="description" content="Stack Overboard: a squid falls out of the sky. Brought to you by Sails.js.">
    <meta name="theme-color" content="#192147">
    <% if (sails.config.environment !== 'production') { %><meta name="robots" content="noindex"><% } %>
    <% /* The game reads this to send the CSRF header on its API calls. */ %>
    <meta name="csrf-token" content="<%= typeof _csrf !== 'undefined' ? _csrf : '' %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/game/game.css">
  </head>
  <body>
    <%- body %>
    <% /* The game is plain scripts, in order. (Kept out of the asset pipeline's
          auto-injection on purpose: the rest of the app doesn't need them.) */ %>
    <script src="/game/js/core.js"></script>
    <script src="/game/js/audio.js"></script>
    <script src="/game/js/art.js"></script>
    <script src="/game/js/save.js"></script>
    <script src="/game/js/ui.js"></script>
    <script src="/game/js/engine.js"></script>
    <script src="/game/js/actors.js"></script>
    <script src="/game/js/rooms.js"></script>
    <script src="/game/js/story.js"></script>
    <script src="/game/js/scenes.js"></script>
    <script src="/game/js/intro.js"></script>
    <script src="/game/js/journal.js"></script>
    <script src="/game/js/main.js"></script>
  </body>
</html>
