<canvas id="stage" aria-label="Stack Overboard: an underwater adventure"></canvas>

<div id="intro-scroll" aria-hidden="true"></div>

<div id="intro-text">
  <div id="intro-title">
    <h1>Stack Overboard</h1>
    <div class="byline">
      <span>Brought to you by</span>
      <a href="https://sailsjs.com" target="_blank" rel="noopener"><img src="/images/sails-logo-blue.png" alt="Sails.js"></a>
    </div>
    <div class="conf">Sailsconf 2026</div>
    <div class="scroll-cue"><span>scroll</span><i></i></div>
    <p class="howto">Click to swim. Click again, faster, to swim faster.<br>Press and hold on the squid to see what it remembers.</p>
    <label class="name-pick">Name your squid <input id="name-pick" maxlength="40" autocomplete="off" spellcheck="false" placeholder="or keep the name it falls with"></label>
  </div>
  <p class="intro-line" id="intro-t1">Above the clouds, swans keep gardens made of glass.</p>
  <p class="intro-line" id="intro-t2">Nothing ever falls off the islands.</p>
  <p class="intro-line" id="intro-t3">Well. Almost nothing.</p>
</div>

<div id="sound-hint">Sound on? Click anywhere.</div>

<label id="cheat" title="Skip ahead, in case your progress was lost">Start at
  <select id="cheat-chapter">
    <option value="1" selected>the beginning</option>
    <option value="2">chapter 2: Hiding</option>
    <option value="3">chapter 3: Clicks</option>
    <option value="4">chapter 4: Down</option>
    <option value="5">chapter 5: The octopus garden</option>
    <option value="6">chapter 6: Warm water</option>
    <option value="7">chapter 7: Home</option>
  </select>
</label>

<div id="hud"></div>

<div id="ribbon" aria-live="polite">
  <div id="inspect">
    <canvas id="inspect-canvas" width="240" height="240" title="Click to interact"></canvas>
    <p id="inspect-label"></p>
  </div>
  <div id="speech">
    <canvas id="portrait" width="200" height="200" aria-hidden="true"></canvas>
    <p id="ribbon-line"></p>
  </div>
  <div id="skin" aria-label="Your skin">
    <button data-c="W" title="Pale (A or 1)"></button>
    <button data-c="R" title="Red (B or 2)"></button>
    <button data-c="B" title="Shimmer (C or 3)"></button>
    <button data-c="G" title="Glow (D or 4)"></button>
  </div>
</div>

<div id="card"></div>
<div id="resume-title"><h1>Stack Overboard</h1></div>
<div id="fade"></div>

<div id="journal" role="dialog" aria-label="What you remember">
  <canvas class="j-frame"></canvas>
  <div class="j-inner">
    <div class="j-head"><h2>What you remember</h2><button class="j-close" aria-label="Close">&times;</button></div>
    <div class="j-tabs"></div>
    <div class="j-body"></div>
  </div>
</div>

<div id="credits">
  <div class="c-inner">
    <h1>Stack Overboard</h1>
    <p class="c-ending" data-ending></p>
    <div class="byline"><span>Brought to you by</span><img src="/images/sails-logo-white.png" alt="Sails.js"></div>
    <p class="conf">Sailsconf 2026</p>
    <p class="c-tally" data-tally></p>
    <p class="c-mcp">The sea remembers what every squid did, and it answers questions. Connect an MCP client to<br><code data-mcp></code></p>
    <div class="c-buttons"><button data-keep>Keep exploring</button><button data-again>Fall again</button></div>
  </div>
</div>
