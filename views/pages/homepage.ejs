<canvas id="stage" aria-label="Stack Overboard: an underwater adventure"></canvas>

<div id="intro-scroll" aria-hidden="true"></div>

<div id="intro-text">
  <div id="intro-title">
    <h1>Stack Overboard</h1>
    <div class="byline">
      <span>Brought to you by</span>
      <a href="https://sailsjs.com" target="_blank" rel="noopener"><img src="/images/sails-logo-blue.png" alt="Sails.js"></a>
    </div>
    <div class="conf">Sailsconf 2026</div>
    <div class="scroll-cue"><span>scroll</span><i></i></div>
  </div>
  <p class="intro-line" id="intro-t1">Above the clouds, the swans keep their glass gardens.</p>
  <p class="intro-line" id="intro-t2">Nothing ever falls from the isles.</p>
  <p class="intro-line" id="intro-t3">Almost nothing.</p>
  <p class="intro-line" id="intro-t4">Below the clouds, the old songs say, there is a sea that remembers</p>
  <p class="intro-line" id="intro-t5">everything that falls into it.</p>
  <p class="intro-line" id="intro-t6">And something down there has been waiting a very long time.</p>
</div>

<div id="sound-hint">click anywhere for sound</div>

<div id="hud">
  <div id="skin" aria-label="Your skin">
    <button data-c="W" title="Pale"></button>
    <button data-c="R" title="Red"></button>
    <button data-c="B" title="Shimmer"></button>
    <button data-c="G" title="Glow"></button>
  </div>
  <button id="btn-journal" title="What you remember (J)" aria-label="What you remember">
    <svg viewBox="0 0 32 32" width="22" height="22"><path d="M16 4c-6 0-10 4-10 9 0 4 3 6 6 6 2 0 4-1 4-3s-1-3-3-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M11 20c-1 3-3 5-5 7M16 21c0 3-1 5-2 7M21 20c1 3 3 5 5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
  <button id="btn-sound" title="Sound (M)" aria-label="Sound">
    <svg viewBox="0 0 32 32" width="20" height="20"><path d="M6 12h5l6-5v18l-6-5H6z" fill="currentColor"/><path class="wave" d="M21 11c2 2 2 8 0 10M24 8c4 4 4 12 0 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="cross" d="M21 12l7 8M28 12l-7 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
  </button>
</div>

<div id="say" aria-live="polite"></div>
<div id="thought" aria-live="polite"></div>
<div id="whisper"></div>
<div id="hint">Click or tap where you want to swim. Arrow keys work too.</div>
<div id="card"></div>
<div id="resume-title"><h1>Stack Overboard</h1></div>
<div id="fade"></div>

<div id="journal" role="dialog" aria-label="What you remember">
  <canvas class="j-frame"></canvas>
  <div class="j-inner">
    <div class="j-head"><h2>What you remember</h2><button class="j-close" aria-label="Close">&times;</button></div>
    <div class="j-tabs"></div>
    <div class="j-body"></div>
  </div>
</div>

<div id="credits">
  <div class="c-inner">
    <h1>Stack Overboard</h1>
    <p class="c-ending" data-ending></p>
    <div class="byline"><span>Brought to you by</span><img src="/images/sails-logo-white.png" alt="Sails.js"></div>
    <p class="conf">Sailsconf 2026</p>
    <p class="c-tally" data-tally></p>
    <p class="c-mcp">The world remembers what every squid did, and you can ask it. Connect any MCP client to<br><code data-mcp></code></p>
    <div class="c-buttons"><button data-keep>Keep exploring</button><button data-again>Fall again</button></div>
  </div>
</div>
